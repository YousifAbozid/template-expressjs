#!/bin/sh
echo "🚀 Running pre-push checks..."

# Check if any source files changed since last push
CHANGED_FILES=$(git diff --name-only @{push}..HEAD 2>/dev/null || git diff --name-only HEAD~1..HEAD)
SOURCE_CHANGED=$(echo "$CHANGED_FILES" | grep -E '\.(js|jsx|ts|tsx|json)$' || true)

if [ -z "$SOURCE_CHANGED" ]; then
  echo "📦 No source files changed, skipping checks"
  exit 0
fi

echo "📦 Source files changed, running full codebase checks..."

# Step 1: Run ESLint with auto-fix
echo "🔍 Running ESLint with auto-fix..."
npm run lint:fix
if [ $? -ne 0 ]; then
  echo "❌ ESLint failed! Please fix remaining linting errors manually before pushing."
  exit 1
fi
echo "✅ ESLint passed (auto-fixed issues where possible)!"

# Step 2: Run Prettier to auto-format
echo "💅 Running Prettier to auto-format code..."
npm run format:all
if [ $? -ne 0 ]; then
  echo "❌ Prettier formatting failed!"
  exit 1
fi
echo "✅ Code formatted successfully!"

# Step 3: Check if there are any changes after auto-fixes
CHANGES_AFTER_FIX=$(git diff --name-only)
if [ -n "$CHANGES_AFTER_FIX" ]; then
  echo "📝 Auto-fixes were applied. Staging changes..."
  git add .
  echo "✨ Changes have been staged. You may want to review them before pushing."
fi

# Step 4: Run build check (for Node.js this is mainly syntax validation)
echo "🏗️  Running build check..."
npm run build
if [ $? -ne 0 ]; then
  echo "❌ Build check failed! Please fix build errors before pushing."
  exit 1
fi
echo "✅ Build check passed!"

echo "🎉 All pre-push checks passed successfully!"