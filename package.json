{
  "name": "template-express-ts",
  "version": "1.0.0",
  "description": "✨ A modern, production-ready Express.js template with TypeScript, decorator-based OpenAPI/Swagger documentation, comprehensive validation and developer tooling (ESLint/Prettier/Husky). Ready for production deployment with optimized architecture 🚀",
  "homepage": "https://github.com/YousifAbozid/template-express-ts#readme",
  "bugs": {
    "url": "https://github.com/YousifAbozid/template-express-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YousifAbozid/template-express-ts.git"
  },
  "license": "MIT",
  "author": {
    "name": "Yousif Abozid",
    "email": "yousif.abozid@yahoo.com",
    "url": "https://github.com/YousifAbozid"
  },
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "npm run clean && tsc && tsc-alias && npm run api:generate",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "api:generate": "npm run api:spec && npm run api:types && npm run api:client",
    "api:spec": "tsx scripts/generate-openapi-spec.ts",
    "api:types": "openapi-typescript ./src/openapi.json --output ./src/types/api.ts",
    "api:client": "swagger-typescript-api generate -p ./src/openapi.json -o ./src/types -n client.ts --no-client",
    "api:validate": "tsx scripts/validate-openapi-spec.ts && npm run type-check",
    "api:docs": "swagger-ui-serve ./src/openapi.json",
    "lint": "eslint src --cache --cache-location .eslintcache",
    "lint:fix": "eslint src --fix --cache --cache-location .eslintcache",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml}\"",
    "fix": "npm run lint:fix && npm run format",
    "test": "npm run format:check && npm run lint && npm run type-check",
    "upgrade": "npx npm-check-updates -u && npm install",
    "prepare": "husky"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.0",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "mongoose": "^9.2.4",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/helmet": "^4.0.0",
    "@types/hpp": "^0.2.7",
    "@types/node": "^25.3.5",
    "@types/reflect-metadata": "^0.1.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "swagger-typescript-api": "^13.3.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --cache --cache-location .eslintcache --no-warn-ignored",
      "prettier --write"
    ],
    "!(src/openapi.json|src/types/api.ts|src/types/client.ts)*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{css,scss,less}": [
      "prettier --write"
    ]
  }
}
