{
  "name": "template-expressjs",
  "version": "1.0.0",
  "description": "A production-ready Express.js template",
  "homepage": "https://github.com/YousifAbozid/template-expressjs#readme",
  "bugs": {
    "url": "https://github.com/YousifAbozid/template-expressjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YousifAbozid/template-expressjs.git"
  },
  "license": "MIT",
  "author": "Yousif Abozid",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "type-check": "tsc --noEmit",
    "generate:types": "openapi-typescript ./src/config/swagger.ts --output ./src/types/api.ts",
    "generate:client": "swagger-typescript-api -p ./src/config/swagger.ts -o ./src/types -n client.ts",
    "lint": "eslint src --cache --cache-location .eslintcache",
    "lint:fix": "eslint src --fix --cache --cache-location .eslintcache",
    "format:all": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "fix-all": "npm run lint:fix && npm run format:all",
    "fix-staged": "lint-staged",
    "upgrade": "npx npm-check-updates -u && npm install",
    "prepare": "husky",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "mongoose": "^9.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@eslint/js": "^9.39.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/express-session": "^1.18.2",
    "@types/express-validator": "^2.20.33",
    "@types/helmet": "^0.0.48",
    "@types/hpp": "^0.2.7",
    "@types/node": "^24.10.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.1.11",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.7.3",
    "swagger-typescript-api": "^13.2.16",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --cache --cache-location .eslintcache",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
